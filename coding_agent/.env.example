# ─── API Keys ─────────────────────────────────────────────────────────
# Replace with your actual API keys from respective providers
# FIREWORK_API_KEY=your_firework_api_key_here
# FREEAI_API_KEY=your_freeai_api_key_here

# ─── Groq API Keys (get from https://console.groq.com/keys) ────────────
# GROQ_API_KEY_1=gsk_your_groq_api_key_here
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# ─── Google Gemini API Keys (get from https://makersuite.google.com/app/apikey) ────────
# GOOGLE_API_KEY_1=your_google_api_key_here
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=

# ─── OpenRouter API Keys (get from https://openrouter.ai/keys) ───────────
# OPENROUTER_API_KEY_1=sk-or-v1-your_openrouter_api_key_here
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# ─── Ollama Configuration ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_TIMEOUT_MS=180000

# ─── LLM Fallback Priority ────────────────────────────────────────────
LLM_FALLBACK_1=ollama
LLM_FALLBACK_2=
LLM_FALLBACK_3=
LLM_FALLBACK_4=
LLM_FALLBACK_5=

# ─── Verified Active Fallback Models ──────────────────────────────────
LLM_FALLBACK_GOOGLE_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_GROQ_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_OLLAMA_MODEL=gemma3:27b
LLM_FALLBACK_OPENAI_MODEL=gpt-4o-mini

LLM_FALLBACK_ANTHROPIC_MODEL=
LLM_FALLBACK_GROK_MODEL=
LLM_FALLBACK_DEEPSEEK_MODEL=
LLM_FALLBACK_TOGETHER_MODEL=

# ─── Enable / Disable Providers ────────────────────────────────────────
# Set to 'true' for providers you want to use (requires corresponding API keys above)
LLM_ENABLE_OLLAMA=true
LLM_ENABLE_OPENROUTER=false
LLM_ENABLE_GROQ=false
LLM_ENABLE_GOOGLE=false
LLM_ENABLE_OPENAI=false
LLM_ENABLE_ANTHROPIC=false
LLM_ENABLE_GROK=false
LLM_ENABLE_DEEPSEEK=false
LLM_ENABLE_TOGETHER=false

# ─── Global LLM Settings & Limits ─────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_GROQ_MAX_TOKENS=4096
LLM_MAX_PRD_CHARS=95000
LLM_GROQ_MAX_PRD_CHARS=95000

OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192

# ─── Frontend URL (for generated apps) ────────────────────────────────
FRONTEND_URL=http://127.0.0.1:5173

# ─── Database URL (for generated apps) ────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ─── Secret Key (for generated apps) ──────────────────────────────────
SECRET_KEY=replace-with-secure-random-key-in-production