# ─── Engg Assurance_IDE: Environment Configuration Template ──────────────
# Copy this file to .env and insert your API keys / configuration values.
# NEVER commit the real .env file with secrets to GitHub!

# ─── LLM Provider API Keys ───────────────────────────────────────────────
# Groq (Ultra-fast LPU inference: https://console.groq.com/keys)
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Google Gemini (Multimodal reasoning: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY_1=your_gemini_api_key_here
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# OpenRouter (Unified multi-model access: https://openrouter.ai/keys)
OPENROUTER_API_KEY_1=your_openrouter_api_key_here
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# OpenAI (Optional)
OPENAI_API_KEY_1=your_openai_api_key_here

# ─── Local Air-Gapped LLM (Ollama) ────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_TIMEOUT_MS=180000

# ─── LLM Provider Toggles ─────────────────────────────────────────────────
LLM_ENABLE_GROQ=true
LLM_ENABLE_GOOGLE=true
LLM_ENABLE_OPENROUTER=false
LLM_ENABLE_OPENAI=false
LLM_ENABLE_OLLAMA=true

# Fallback Priority Ordering
LLM_FALLBACK_1=groq
LLM_FALLBACK_2=google
LLM_FALLBACK_3=ollama
LLM_FALLBACK_4=openrouter

# ─── Ports & Services ─────────────────────────────────────────────────────
PORT=3001
ASSURANCE_API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5174
ASSURANCE_FRONTEND_URL=http://localhost:5173

# ─── Database & Storage ───────────────────────────────────────────────────
DB_ENGINE=sqlite
DATABASE_URL=sqlite:///./mission_control.db
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ─── Model Parameters ─────────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_GROQ_MAX_TOKENS=4096
